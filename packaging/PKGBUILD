# Maintainer: ferreo <ferreo@pika-os.com>
pkgname=omadungeon
pkgver=0.1.1
pkgrel=1
pkgdesc="Procedural rogue-like dungeon crawler skinned by your Omarchy theme"
arch=('x86_64')
url="https://github.com/ferrreo/omadungeon"
license=('BSD-3-Clause')
# libpulse, not pulseaudio: the engine dlopens libpulse.so.0, which is the client
# library. `pulseaudio` is the daemon and it conflicts with pipewire-pulse, so depending
# on it drags a PipeWire system off PipeWire to satisfy a library it already has.
depends=('glibc' 'libx11' 'libxcursor' 'libxinerama' 'libxi' 'libxrandr' 'libxext'
         'libxrender' 'alsa-lib' 'libpulse' 'mesa' 'wayland' 'libxkbcommon' 'systemd-libs')
# Everything the engine only reaches for if it is there, mirroring the Recommends and
# Suggests the Debian package derives from the same binary.
optdepends=('libdecor: client-side decorations on Wayland'
            'dbus: desktop integration'
            'fontconfig: system fonts'
            'vulkan-icd-loader: Vulkan rendering'
            'speech-dispatcher: screen-reader support')
makedepends=('godot' 'git')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  mkdir -p export/linux
  godot --headless --path . --import
  godot --headless --path . --export-release "Linux x86_64" export/linux/omadungeon
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 export/linux/omadungeon "$pkgdir/usr/lib/$pkgname/omadungeon"
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/omadungeon" "$pkgdir/usr/bin/omadungeon"
  install -Dm644 packaging/omadungeon.desktop "$pkgdir/usr/share/applications/omadungeon.desktop"
  install -Dm644 packaging/omadungeon.metainfo.xml "$pkgdir/usr/share/metainfo/org.omadungeon.Omadungeon.metainfo.xml"
  install -Dm644 packaging/icons/omadungeon-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/omadungeon.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/CREDITS.md "$pkgdir/usr/share/doc/$pkgname/CREDITS.md"
}
