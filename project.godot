; --- UI navigation -----------------------------------------------------------
; Godot's built-in `ui_*` defaults (ProjectSettings::_add_builtin_input_map) give
; `ui_accept` and `ui_cancel` **no gamepad event at all**, so on a pad A and B did
; nothing on every menu, board and dialog in the game. They are spelled out here
; instead of inherited, and the pad half is the point of the entries.
;
; A doubles as `dodge` and Enter/Space already did the same on the keyboard; boards
; and menus pause the run (RunManager._hold_pause, PauseMenu.open) and withdraw player
; input, so the two never fire at the same moment.
;
; The left stick is deliberately NOT bound to the directional `ui_*` actions.
; `InputEventJoypadMotion.action_match` has no edge detection: every motion event past
; the deadzone reads as a fresh press, so one physical flick of the stick arrived as
; three or four `ui_right` presses and the class select skipped from Fighter to Oligarch.
; `UiStickNav` (src/ui/ui_stick_nav.gd) converts the stick into one press per flick plus
; a held auto-repeat, with hysteresis, and synthesises these same actions.
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194310,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":true,"script":null)
]
}
